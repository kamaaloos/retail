# Normalize line endings for the whole repo
* text=auto eol=lf

# Keep Windows scripts CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (don't touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.jar binary
*.keystore binary
*.jks binary
*.db binary
*.sqlite binary
*.sqlite3 binary
